    "id": "8f0cc011-dfb0-4c96-9831-70fbb5de5938",
    "name": "[AGENTE IA] 01 Recebe Mensagem WhatsApp",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "recebimento-whatsapp",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "84e8e389-e419-4fd9-8bbb-d35ddbc90273",
        "name": "Webhook WhatsApp",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [
          250,
          300
        ],
        "webhookId": "recebimento-whatsapp"
      },
      {
        "parameters": {
          "functionCode": "const msg = $input.first().json.data || $input.first().json;\nconst telefone = msg.pushName ? msg.key?.remoteJid?.split('@')[0] : (msg.key?.remoteJid || '');\nconst texto = msg.message?.conversation || msg.message?.extendedTextMessage?.text || '';\nreturn [{json:{telefone,texto,raw:msg}}];"
        },
        "id": "786b2d79-f3e5-4d99-9a4d-6ef70f15b438",
        "name": "Extrair Dados",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          450,
          300
        ]
      },
      {
        "parameters": {
          "url": "https://jj-ferreiras.com.br/MaposV5/api/v2/autorizacoes/verificar",
          "method": "POST",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({\"numero_telefone\": $json.telefone, \"acao\": $json.texto, \"contexto\": \"primeira_interacao\"}) }}",
          "options": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "id": "e66af378-1633-4c78-8c2e-7e7176aaf237",
        "name": "Verificar Autorizacao",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          650,
          300
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "35dce5df-0e0d-4520-b888-91cefdc96636",
            "name": "mapos_api_key"
          }
        }
      },
      {
        "parameters": {
          "functionCode": "const resp=$input.first().json;\nconst nivel=resp.data?.nivel_acesso||1;\nconst precisa=nivel>=4 && !resp.data?.token;\nreturn [{json:{...resp,precisa_solicitar:precisa,telefone:$('Extrair Dados').item.json.telefone,texto:$('Extrair Dados').item.json.texto}}];"
        },
        "id": "4f2b8bab-1080-4f61-ae21-b5012aff9e65",
        "name": "Analisar Nivel",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          850,
          300
        ]
      },
      {
        "parameters": {
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.precisa_solicitar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "id": "fe2a8677-a39b-418d-b6ce-49548040960e",
        "name": "Precisa Autorizacao?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          1050,
          200
        ]
      },
      {
        "parameters": {
          "functionCode": "return [{json:{code:200, body:'🔒 Esta acao requer autorizacao do administrador. Responda com CONFIRMAR se deseja prosseguir.', headers:{}}}];"
        },
        "id": "23e9d734-df3f-496d-9eee-773d5bed71d9",
        "name": "Solicitar Token",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          1250,
          150
        ]
      },
      {
        "parameters": {
          "url": "https://jj-ferreiras.com.br/MaposV5/api/v2/acoes/executar",
          "method": "POST",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({\"telefone\": $json.telefone, \"acao\": $json.texto || \"mensagem\", \"token\": $json.data?.token || \"\", \"dados\": $json.data || {} }) }}",
          "options": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "id": "c09b7a0a-967e-4df5-b62d-605ace83cbf3",
        "name": "Executar Acao",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.1,
        "position": [
          1250,
          250
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "35dce5df-0e0d-4520-b888-91cefdc96636",
            "name": "mapos_api_key"
          }
        }
      },
      {
        "parameters": {
          "functionCode": "const r=$input.first().json;\nlet msg=r.message || r.data?.mensagem || '✅ Acao concluida!';\nif(r.data?.pdf_url) msg+='\\n📎 PDF: '+r.data.pdf_url;\nif(r.data?.os_id) msg+='\\n📋 OS #'+r.data.os_id;\nreturn [{json:{code:200,body:msg,headers:{}}}];"
        },
        "id": "77b28ff0-ab90-4d70-ac2e-5ae1ce959369",
        "name": "Formatar Resposta",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          1450,
          250
        ]
      },
      {
        "parameters": {
          "options": {}
        },
        "id": "a65631b6-55a6-4a06-97f4-01bc2fbba236",
        "name": "Responder WhatsApp",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [
          1650,
          250
        ]
      }
    ],
    "connections": {
